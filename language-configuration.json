{
	"comments": {
		"lineComment": { "comment": "--" },
		"blockComment": ["--[[", "]]"]
	},
	"brackets": [
		["{", "}"],
		["[", "]"],
		["(", ")"]
	],
	"autoClosingPairs": [
		{ "open": "{", "close": "}" },
		{ "open": "[", "close": "]" },
		{ "open": "(", "close": ")" },
		{ "open": "\"", "close": "\"", "notIn": ["string"] },
		{ "open": "'", "close": "'", "notIn": ["string"] },
		{ "open": "`", "close": "`", "notIn": ["string"] }
	],
	"surroundingPairs": [
		["{", "}"],
		["[", "]"],
		["(", ")"],
		["\"", "\""],
		["'", "'"],
		["`", "`"]
	],
	"indentationRules": {
		"increaseIndentPattern": "^\\s*(?:.*\\b(?:function|then|do|repeat|else)\\b(?!.*\\bend\\b)|.*\\{\\s*)\\s*(?:--.*)?$",
		"decreaseIndentPattern": "^\\s*(?:end|else|elseif|until|\\})\\b?"
	}
}
