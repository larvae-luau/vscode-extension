{
	"name": "larvae",
	"displayName": "Larvae",
	"description": "Formatting, lints, and lint fixes for Luau, from the larvae toolchain",
	"version": "0.8.1",
	"publisher": "AndrewBordis",
	"license": "MIT",
	"icon": "assets/larvae.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/larvae-luau/vscode-extension"
	},
	"engines": {
		"vscode": "^1.102.0"
	},
	"categories": [
		"Formatters",
		"Linters",
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:lua",
		"onLanguage:luau",
		"workspaceContains:**/larvae.toml"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "luau",
				"aliases": [
					"Luau"
				],
				"extensions": [
					".luau"
				],
				"configuration": "./language-configuration.json",
				"icon": {
					"light": "./assets/luau-file-icon-light.svg",
					"dark": "./assets/luau-file-icon-dark.svg"
				}
			}
		],
		"grammars": [
			{
				"language": "luau",
				"scopeName": "source.luau",
				"path": "./syntaxes/luau.tmLanguage.json",
				"unbalancedBracketScopes": [
					"keyword.operator.comparison",
					"keyword.operator.type.function"
				],
				"tokenTypes": {
					"meta.template.expression": "other",
					"meta.template.expression string": "string",
					"meta.template.expression comment": "comment"
				}
			},
			{
				"scopeName": "markdown.luau.codeblock",
				"path": "./syntaxes/luau-markdown-codeblock.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.luau": "luau"
				}
			}
		],
		"commands": [
			{
				"command": "larvae.restartServer",
				"title": "Restart Language Server",
				"category": "Larvae"
			}
		],
		"configuration": {
			"title": "Larvae",
			"properties": {
				"larvae.path": {
					"type": "string",
					"default": "",
					"markdownDescription": "Path to the `larvae` executable. Leave empty to use `larvae` from `PATH` (falling back to `~/.larvae/bin/larvae`)."
				},
				"larvae.processOnSave": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"markdownDescription": "Run `larvae process` for the containing workspace folder whenever a Luau file is saved. (This is also done in process watch mode)"
				},
				"larvae.processProfile": {
					"type": "string",
					"default": "",
					"scope": "resource",
					"markdownDescription": "Profile to pass to `larvae process --profile <name>`, merging `[profile.<name>]` from `larvae.toml` over the base config. Leave empty to build with the base config only."
				},
				"larvae.hideOutputFolder": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"markdownDescription": "Hide larvae's output directory (the `output` entry in `larvae.toml`) from the explorer by managing a `files.exclude` entry in the workspace settings. Only applies to folders that contain a `larvae.toml`."
				},
				"larvae.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the larvae language server."
				}
			}
		},
		"configurationDefaults": {
			"[luau]": {
				"editor.quickSuggestions": {
					"strings": true
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"test": "npm run compile && npx --yes @vscode/vsce package",
		"watch": "tsc -watch -p ./"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.14",
		"@types/node": "^20.0.0",
		"@types/vscode": "^1.90.0",
		"typescript": "^5.4.0"
	}
}
